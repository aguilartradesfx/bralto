SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Stripe
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Set this after creating the webhook destination in the Stripe dashboard.
# Endpoint URL to register: ${NEXT_PUBLIC_SITE_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ============================================================
# GoHighLevel — two separate Marketplace apps required.
#
# AGENCY APP: holds scopes like saas/company.write, locations.write.
#   Redirect URI to register: ${NEXT_PUBLIC_SITE_URL}/api/integrations/agency/callback
# SUB-ACCOUNT APP: holds scopes like contacts.write, calendars/events.write.
#   Redirect URI to register: ${NEXT_PUBLIC_SITE_URL}/api/integrations/location/callback
# ============================================================
HIGHLEVEL_AGENCY_CLIENT_ID=
HIGHLEVEL_AGENCY_CLIENT_SECRET=
HIGHLEVEL_AGENCY_REDIRECT_URI=

HIGHLEVEL_SUBACCOUNT_CLIENT_ID=
HIGHLEVEL_SUBACCOUNT_CLIENT_SECRET=
HIGHLEVEL_SUBACCOUNT_REDIRECT_URI=

# Agency / company id (for sub-account creation).
HIGHLEVEL_COMPANY_ID=cnKny2ektFPRpPLw4AOb
# Default SaaS plan id used when checkout session metadata.ghl_plan_id is absent.
HIGHLEVEL_DEFAULT_SAAS_PLAN_ID=684c43e8a8208c0a61936158

# Bralto's own GHL location (used by the bookings flow).
HIGHLEVEL_BRALTO_LOCATION_ID=
